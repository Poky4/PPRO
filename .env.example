# Application Configuration
PROJECT_NAME="Rezervace v ordinaci"
ENVIRONMENT=development
API_V1_STR=/api/v1

# Security
# In production, generate a secure secret key (e.g. `openssl rand -hex 32`)
SECRET_KEY=super-secret-key-change-me-for-production-use-ppro-2026
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database (PostgreSQL)
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ordinace_db

# Initial Admin Account Seed
FIRST_SUPERUSER_USERNAME=admin
FIRST_SUPERUSER_PASSWORD=admin123
FIRST_SUPERUSER_EMAIL=admin@ordinace.cz
FIRST_SUPERUSER_FULLNAME="Systémový Administrátor"
